<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="MainMenu.uss" />
    <!-- One viewport, nothing scrolls (UI consolidation 2026-09-29). MainMenuController fills the named parts. -->
    <ui:VisualElement name="root" class="menu-root po-tokens">
        <ui:VisualElement name="panel" class="menu-panel">
            <ui:VisualElement name="anchorTop" class="menu-anchor" />
            <ui:VisualElement name="roster" class="roster" />
            <ui:VisualElement name="slots" class="slots" />
            <ui:VisualElement name="eventList" class="event-grid" />
            <ui:VisualElement name="detail" class="detail">
                <ui:VisualElement class="detail-head">
                    <ui:Label name="eventTitle" class="detail-title" />
                    <ui:Label name="eventBrain" class="detail-brain" />
                </ui:VisualElement>
                <ui:Label name="eventRules" class="event-rules" />
                <ui:VisualElement name="recordTop" class="record-top" />
                <ui:Label name="eventRecord" class="event-record" />
            </ui:VisualElement>
            <ui:VisualElement class="action-row">
                <ui:Button name="recordsButton" text="★" tooltip="World records on the event tiles + the selected event's top 5" class="chip-button records-button" />
                <ui:Button name="gauntletButton" text="GAUNTLET" tooltip="Tap events to build a series" class="chip-button gauntlet-toggle" />
                <ui:Button name="runAllButton" text="RUN ALL" tooltip="Every playable event with the 16 entrants, by itself, to one winner" class="chip-button runall-button" />
                <ui:Button name="playButton" text="PLAY" class="play-button" />
            </ui:VisualElement>
            <ui:VisualElement name="anchorBottom" class="menu-anchor" />
        </ui:VisualElement>
        <ui:VisualElement name="overlay" class="menu-overlay" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
