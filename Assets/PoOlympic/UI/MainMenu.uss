/* Main menu (MainMenu.uxml / MainMenuController.cs) — one viewport, nothing scrolls (UI consolidation 2026-09-29).
   The panel scales to 1920 units tall (PoOlympicPanelSettings: match height), so the column below always has the same
   height; the event grid takes what is left. Width is 690-1080 units depending on the phone.
   Sizes / colours: Tokens.uss (no text under 28, primary buttons 104). */
@import url("HudAnchors.uss");

.menu-root {
    flex-grow: 1;
    align-items: center;
    background-color: var(--po-ink);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-Regular.ttf");
    color: var(--po-fg);
}
.menu-panel {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    padding: var(--po-pad) var(--po-gap) var(--po-pad-s) var(--po-gap);
}
.menu-anchor { flex-shrink: 0; }
.menu-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
#anchorTop, .roster, .slots, .event-grid, .detail, .action-row { margin-bottom: var(--po-pad); }
.slots { margin-bottom: var(--po-s4); }

/* ---------- roster: tap a card = all 8 lanes ---------- */
.roster { flex-direction: row; flex-shrink: 0; }
.athlete-card {
    flex-grow: 1;
    flex-basis: 0;
    height: var(--po-btn);
    margin: 0;
    padding: 0 var(--po-pad);
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    background-color: var(--po-card);
    border-width: var(--po-line);
    border-color: var(--po-gold);
    border-radius: var(--po-radius-l);
    color: var(--po-fg);
}
.athlete-card:hover { background-color: var(--po-card-hover); }
/* four roster cards share the row since KIM (2026-10-11): text stays at the 28 px minimum (PortraitLayoutTests), so the
   cards get tighter padding and lose the "×8" label (the tooltip and the header line "8× NAME" still say it) */
.athlete-card { padding: 0 var(--po-s4); }
.athlete-card .athlete-fill { display: none; }
.athlete-head > .menu-chip { width: 34px; margin-right: var(--po-s4); }
.athlete-card--gap { margin-right: var(--po-pad); }
.athlete-head { flex-direction: row; align-items: center; }
.athlete-head > .menu-chip { margin-right: var(--po-s6); }
.athlete-name { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: nowrap; overflow: hidden; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); font-size: var(--po-text-name); color: var(--po-gold); }
.athlete-stats { font-size: var(--po-text); color: var(--po-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.athlete-fill { flex-shrink: 0; white-space: nowrap; margin-left: var(--po-s2); font-size: var(--po-text); color: var(--po-cyan); -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }

/* body chips (same colours as the broadcast HUD) */
.menu-chip {
    width: 42px;
    height: 38px;
    margin-right: var(--po-s10);
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: var(--po-text);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    border-radius: var(--po-radius-s);
    background-color: var(--po-matt);
    color: var(--po-white);
}
.menu-chip--zombie { background-color: var(--po-zombie); color: var(--po-on-zombie); }
.menu-chip--grandma { background-color: var(--po-grandma); color: var(--po-white); }
.menu-chip--kim { background-color: var(--po-kim); color: var(--po-on-kim); }

/* ---------- entrants: 2 rows of 8 (the field of 16), tap = next athlete ---------- */
.slots { flex-direction: row; flex-wrap: wrap; justify-content: space-between; flex-shrink: 0; }
.entrant {
    width: 12%;
    height: var(--po-btn);
    margin: 0;
    margin-bottom: var(--po-pad-s);
    padding: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--po-tile);
    border-width: var(--po-line);
    border-color: var(--po-tile);
    border-bottom-width: var(--po-s6);
    border-bottom-color: var(--po-matt);
    border-radius: var(--po-radius);
    color: var(--po-fg);
}
.entrant:hover { background-color: var(--po-card); }
.entrant--zombie { border-bottom-color: var(--po-zombie); }
.entrant--grandma { border-bottom-color: var(--po-grandma); }
.entrant--kim { border-bottom-color: var(--po-kim); }
.entrant--sub { opacity: 0.55; }
.entrant--fixed { opacity: 0.7; }
.entrant-no { font-size: var(--po-text); color: var(--po-muted); }
.entrant-name { -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); font-size: var(--po-text); white-space: nowrap; }

/* ---------- events: fixed grid (rows grow to fill the viewport) ---------- */
.event-grid { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.event-row { flex-direction: row; flex-grow: 1; flex-basis: 0; min-height: 0; }
.event-row--gap { margin-bottom: var(--po-pad-s); }
.event-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding: var(--po-s10) var(--po-pad);
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    overflow: hidden;
    background-color: var(--po-card);
    border-width: var(--po-line);
    border-color: var(--po-card);
    border-radius: var(--po-radius-l);
    color: var(--po-fg);
}
.event-button--gap { margin-right: var(--po-pad-s); }
.event-button:hover { background-color: var(--po-card-hover); }
.event-button--selected { border-color: var(--po-gold); background-color: var(--po-card-selected); }
.event-button--in-gauntlet { border-color: var(--po-cyan); }
.event-button--empty { visibility: hidden; }
.event-button--coming-soon { opacity: 0.58; }
.event-number { font-size: var(--po-text-h); color: var(--po-gold); -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.event-name { font-size: var(--po-text); white-space: normal; }
.event-mark { font-size: var(--po-text); margin-top: var(--po-s4); color: var(--po-green); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.event-mark--none { color: var(--po-muted); }
.event-mark--unavailable { color: var(--po-muted); }
.event-order {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 48px;
    height: 48px;
    font-size: var(--po-text);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    -unity-text-align: middle-center;
    color: var(--po-ink);
    background-color: var(--po-cyan);
    border-radius: var(--po-radius-pill);
}

/* ---------- selected event: rules + world record, or its all-time top 5 (★) ---------- */
.detail {
    height: 300px;
    flex-shrink: 0;
    overflow: hidden;
    padding: var(--po-s10) var(--po-gap);
    background-color: var(--po-tile);
    border-radius: var(--po-radius-l);
}
.detail-head { flex-direction: row; align-items: center; height: 44px; }
.detail-title { flex-grow: 1; flex-shrink: 1; font-size: var(--po-text-m); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.detail-brain { font-size: var(--po-text); padding: 0 var(--po-s10); border-radius: var(--po-radius-s); color: var(--po-soft); background-color: var(--po-card); }
.event-rules { font-size: var(--po-text); color: var(--po-body); white-space: normal; flex-grow: 1; flex-shrink: 1; overflow: hidden; margin-top: var(--po-s4); }
.event-record { font-size: var(--po-text); color: var(--po-gold); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.record-top { flex-grow: 1; margin-top: var(--po-s4); display: none; }
.record-top-row { flex-direction: row; height: 44px; align-items: center; }
.record-top-rank { width: 44px; font-size: var(--po-text); color: var(--po-gold); -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.record-top-mark { flex-grow: 1; flex-shrink: 1; font-size: var(--po-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.record-top-who { flex-shrink: 1; margin-left: var(--po-pad); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: var(--po-text); color: var(--po-body-hi); }
.record-top-date { margin-left: var(--po-pad); white-space: nowrap; font-size: var(--po-text); color: var(--po-muted); }
.record-top-none { font-size: var(--po-text); color: var(--po-muted); }
.detail--records > .event-rules, .detail--records > .event-record { display: none; }
.detail--records > .record-top { display: flex; }

/* ---------- actions: ★ records · gauntlet · play ---------- */
.action-row { flex-direction: row; align-items: center; flex-shrink: 0; }
.chip-button {
    height: var(--po-btn);
    margin: 0;
    margin-right: var(--po-pad-s);
    padding: 0 var(--po-s24);
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    font-size: var(--po-text);
    letter-spacing: 2px;
    color: var(--po-fg);
    background-color: var(--po-card);
    border-width: 0;
    border-radius: var(--po-radius-l);
}
.chip-button:hover { background-color: var(--po-card-hover); }
.records-button { width: var(--po-btn); padding: 0; font-size: var(--po-text-xl); letter-spacing: 0; color: var(--po-gold); }
.records-button--on { color: var(--po-ink); background-color: var(--po-gold); }
.gauntlet-toggle--on { color: var(--po-ink); background-color: var(--po-cyan); }
.play-button {
    flex-grow: 1;
    height: var(--po-btn);
    margin: 0;
    font-size: var(--po-text-xl);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: var(--po-ink);
    background-color: var(--po-gold);
    border-width: 0;
    border-radius: var(--po-radius-pill);
}
.play-button:hover { background-color: var(--po-gold-hover); }
.play-button:disabled { opacity: 0.4; }

/* bottom bar centre: the last gauntlet result */
.menu-last { flex-grow: 1; flex-shrink: 1; font-size: var(--po-text); color: var(--po-cyan); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
