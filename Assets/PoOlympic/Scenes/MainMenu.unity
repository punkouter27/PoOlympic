  m_Name: 
  m_EditorClassIdentifier: PoOlympic.Runtime::PoOlympic.MainMenuController
  events:
  - number: 1
    displayNumber: 1
    name: The Iron Pedestal
    rules: 8 athletes stand shoulder to shoulder on one narrow iron beam. Gusts shove them into each other; the last one still on the beam wins.
    brain: rung0
    scene: Event_IronPedestal_Heat
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 5
    displayNumber: 2
    name: The Gust Gauntlet
    rules: 'All 8 share one shaker floor: lateral wind bursts push them into each other and the floor jolts everyone at once. Scored on recovery time back to your spot.'
    brain: rung2
    scene: Event_GustGauntlet
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 8
    displayNumber: 3
    name: 30m All Fours
    rules: 30 m race on hands and feet, crawlers side by side 1.1 m apart - bumping and tangling allowed. Falling never eliminates - get back on all fours and keep going; standing up is a DQ.
    brain: crawl
    scene: Event_30mAllFours
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 9
    displayNumber: 4
    name: The Inverted Sprint
    rules: 20m reverse sprint. Disqualification upon lane drifting or backward tumbling.
    brain: rung2
    scene: Event_InvertedSprint
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 10
    displayNumber: 5
    name: Crab Shuffle Relay
    rules: Eight athletes side-step 20 m between parallel rails. Close lanes create shoulder-to-shoulder contact; fastest clean finish wins.
    brain: rung2
    scene: Event_CrabShuffle
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 11
    displayNumber: 6
    name: Slalom Sprint
    rules: 'Mirror slalom: neighbouring lanes weave in opposite directions and meet at every other gate. Penalties added for missed gates or clipping flags.'
    brain: rung2
    scene: Event_SlalomSprint
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 12
    displayNumber: 7
    name: The 360 Turntable
    rules: '8 spin spots on one tight ring: turn 3 times without being knocked off your spot. Scored on speed and drift; pushed onto a neighbour''s spot is a DQ.'
    brain: rung2
    scene: Event_360Turntable
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 13
    displayNumber: 8
    name: Steeplechase Jog
    rules: 50m sprint requiring sustained aerial flight phases between foot strikes; scored on ground time (finish time minus hang time).
    brain: flight
    scene: Event_SteeplechaseJog
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 14
    displayNumber: 9
    name: The Alpine Ramp
    rules: Ascending a 15-degree ramp straight into a finish sensor.
    brain: rung4
    scene: Event_AlpineRamp
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 15
    displayNumber: 10
    name: Cross-Country Rubble
    rules: Traversal across randomized mounds and ruts.
    brain: rung4
    scene: 
    lineup: []
    participants: []
    bodies: []
  - number: 16
    displayNumber: 11
    name: The Platform Drop
    rules: Rapid descent down stepped terrain; scored on descent speed and soft-landing dissipation.
    brain: rung4
    scene: 
    lineup: []
    participants: []
    bodies: []
  - number: 17
    displayNumber: 12
    name: Stadium Stair Climb
    rules: 20-step vertical climb without catching toes on step lips.
    brain: rung4
    scene: 
    lineup: []
    participants: []
    bodies: []
  - number: 19
    displayNumber: 13
    name: Terminal Velocity Sprint
    rules: Open sprint at top speed; past the green break line the field squeezes to the inside, shoulder to shoulder. Ranked by peak speed; a fall ranks last.
    brain: rung2
    scene: Event_TerminalVelocity
    lineup: []
    participants: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 20
    displayNumber: 14
    name: Low Hurdle Dash
    rules: 30m sprint incorporating 0.3m hurdles requiring coordinated high-knee clearance.
    brain: rung5
    scene: 
    lineup: []
    participants: []
    bodies: []
  - number: 21
    displayNumber: 15
    name: The Sandpit Long Jump
    rules: All 16 athletes sprint and jump in overlapping, staggered waves toward a shared sandpit. Longest legal jump wins; crowded run-ups and landings create chaotic contact.
    brain: rung5
    scene: 
    lineup: []
    participants: []
    bodies: []
  - number: 27
