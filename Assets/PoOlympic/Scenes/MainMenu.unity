--- !u!114 &1778484236
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1778484235}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 213e7403b4b52c348978b1782a2866f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: PoOlympic.Runtime::PoOlympic.MainMenuController
  events:
  - number: 1
    name: The Iron Pedestal
    rules: 8 athletes stand shoulder to shoulder on one narrow iron beam. Gusts shove them into each other; the last one still on the beam wins.
    brain: rung0
    scene: Event_IronPedestal_Heat
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 2
    name: Sumo Ring
    rules: 8 athletes spawn around a 2.9 m raised disc and charge inward. Push rivals off the ring or knock them down; last standing wins.
    brain: rung2
    scene: Event_SumoRing
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 3
    name: Narrow Bridge Crossing
    rules: 4 athletes start on each end of a 1.44 m wide elevated bridge and race across head-on. First to cross without falling off wins.
    brain: rung2
    scene: Event_NarrowBridge
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 4
    name: Funnel Bottleneck Sprint
    rules: 35 m sprint through two narrow 1.8 m chicane gates. Runners pile into the bottlenecks and fight through; fastest to finish wins.
    brain: rung2
    scene: Event_FunnelBottleneck
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 5
    name: The Gust Gauntlet
    rules: 'All 8 share one shaker floor: lateral wind bursts push them into each other and the floor jolts everyone at once. Scored on recovery time back to your spot.'
    brain: rung2
    scene: Event_GustGauntlet
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 6
    name: Figure-8 Crossroad Dash
    rules: Two 4-runner packs sprint on perpendicular tracks intersecting at a shared central junction. Survive the cross-traffic collision and finish fastest.
    brain: rung2
    scene: Event_CrossroadDash
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 7
    name: Shrinking Safe-Zone
    rules: Athletes roam an open arena until safe pads activate (7, 5, 3, 1). Race to claim a pad and block rivals out before the buzzer; last standing wins.
    brain: rung2
    scene: Event_ShrinkingSafeZone
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 8
    name: 30m All Fours
    rules: 30 m race on hands and feet, crawlers side by side 1.1 m apart - bumping and tangling allowed. Falling never eliminates - get back on all fours and keep going; standing up is a DQ.
    brain: crawl
    scene: Event_30mAllFours
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 10
    name: Center Beacon Scramble
    rules: All 8 charge a single central 1.15 m beacon for 30 s. Score time inside the zone while shoving rivals out; highest hold time wins.
    brain: rung2
    scene: Event_CenterBeacon
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 12
    name: The 360 Turntable
    rules: '8 spin spots on one tight ring: turn 3 times without being knocked off your spot. Scored on speed and drift; pushed onto a neighbour''s spot is a DQ.'
    brain: rung2
    scene: Event_360Turntable
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 18
    name: Inside-Rail Pack Mile
    rules: 84.39 m sprint where all 8 immediately squeeze onto the inside rail from 2 m. Continuous shoulder-to-shoulder pack contact to the finish.
    brain: rung2
    scene: Event_PackMile
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 19
    name: Terminal Velocity Sprint
    rules: Open sprint at top speed; past the green break line the field squeezes to the inside, shoulder to shoulder. Ranked by peak speed; a fall ranks last.
    brain: rung2
    scene: Event_TerminalVelocity
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  - number: 25
    name: Hilltop Scramble
    rules: Climb 4 converging ramps up to a raised 2.6 m summit platform and shove rivals off the edges. Highest summit time wins.
    brain: rung2
    scene: Event_HilltopScramble
    lineup: []
    bodies:
    - MATT
    - ZOMBIE
    - GRANDMA
    - KIM
  columns: 4
  idleDemoSeconds: 45
