.utmp/

# per-tick action logs (ActionLog.cs, watch_gate.py --log-actions): large, regenerated
parity/actions/

# WebGL build: Burst output Unity writes beside the project
/Data/

# Generated Unity C# project files
/*.csproj

# parity/: local working folder of the training / gate tools (reports, candidate brains, reference trajectories,
# captures). New files ignored since 2026-11-20; files tracked before that (brains, references) still are.
# There is no archive-261120 release (checked 2026-11-22).
/parity/
# CI's CPU venv for the fast pytest tier
Training/.ci-venv/
# test-run XML results (regenerated by every run; Builds/ holds the publish script's)
SCREENSHOTS/*.xml

# Unity Test Runner leaves these behind when a run is interrupted
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta
