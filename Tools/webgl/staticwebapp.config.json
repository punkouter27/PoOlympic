{
  "mimeTypes": {
    ".unityweb": "application/octet-stream",
    ".data": "application/octet-stream",
    ".wasm": "application/wasm",
    ".symbols.json": "application/json"
  },
  "routes": [
    {
      "route": "/Build/*.unityweb",
      "headers": {
        "Content-Encoding": "gzip",
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/Build/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}
